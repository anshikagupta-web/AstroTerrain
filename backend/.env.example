# LOCAL DEVELOPMENT ONLY. Never commit .env or use these credentials in production.
POSTGRES_DB=astroterrain
POSTGRES_USER=astroterrain
POSTGRES_PASSWORD=local-dev-change-me
# Used when starting the API directly on the host (not in Docker):
DATABASE_URL=postgresql+asyncpg://astroterrain:local-dev-change-me@localhost:5432/astroterrain
# CORS_ORIGINS must be a JSON list when configured through .env.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
